<Window x:Class="SingBoxWin.Native.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="Root" Background="{ThemeResource ShellBrush}" RequestedTheme="Dark">
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Margin="20,0,150,0"><TextBlock Text="sing-box" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13"/></Grid>
  <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" OpenPaneLength="150" IsPaneOpen="True" CompactModeThresholdWidth="0" ExpandedModeThresholdWidth="0" AlwaysShowHeader="False" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI">
   <NavigationView.Resources>
    <ResourceDictionary>
     <ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary x:Key="Dark">
       <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#14FFFFFF"/>
       <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#14FFFFFF"/>
       <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0AFFFFFF"/>
      </ResourceDictionary>
      <ResourceDictionary x:Key="Light">
       <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#0D000000"/>
       <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#0D000000"/>
       <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0A000000"/>
      </ResourceDictionary>
     </ResourceDictionary.ThemeDictionaries>
     <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#0A84FF"/>
     <x:Double x:Key="NavigationViewItemOnLeftMinHeight">36</x:Double>
     <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">16</x:Double>
     <x:Double x:Key="NavigationViewSelectionIndicatorWidth">3</x:Double>
     <x:Double x:Key="NavigationViewSelectionIndicatorRadius">2</x:Double>
     <Thickness x:Key="NavigationViewItemContentPresenterMargin">0</Thickness>
     <Thickness x:Key="NavigationViewItemButtonMargin">4</Thickness>
    </ResourceDictionary>
   </NavigationView.Resources>
   <Grid MinWidth="650" Padding="20,16,20,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <InfoBar x:Name="Notice" IsOpen="False" Severity="Error" IsClosable="True" Margin="0,0,0,16"/>
    <Grid Grid.Row="1" Margin="0,0,0,20"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock x:Name="Heading" FontSize="26" FontWeight="SemiBold"/><ProgressRing x:Name="Busy" Width="24" Height="24" IsActive="False"/></StackPanel><StackPanel x:Name="Toolbar" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"/></Grid>
    <Frame x:Name="ContentFrame" Grid.Row="2"/>
   </Grid>
  </NavigationView>
 </Grid>
</Window>